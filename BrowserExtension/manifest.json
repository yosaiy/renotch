{
  "manifest_version": 3,
  "name": "Re:notch Browser Activity",
  "version": "1.0.1",
  "description": "Shows YouTube playback and browser download progress in Re:notch.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    }
  ]
}
